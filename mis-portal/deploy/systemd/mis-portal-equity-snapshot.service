[Unit]
Description=IWS MIS Portal — Equity Snapshot Worker
After=network.target postgresql.service

[Service]
Type=oneshot
User=SAdmin
WorkingDirectory=/var/www/mis-portal
Environment=HOME=/home/SAdmin
# Snapshots every entity's live Indian-broker positions and diffs consecutive ticks to
# detect the day's buys/sells (written to stock_transaction as source='snapshot' so they
# feed Realised Gains + the Equity "Traded today" panel). The worker self-guards market
# hours (09:00–15:45 IST) and exits instantly when closed, so a fixed hourly+open+close
# timer costs nothing off-session.
ExecStart=/var/www/.venv/bin/python /var/www/mis-portal/workers/equity_snapshot_worker.py
StandardOutput=append:/var/log/mis-portal-equity-snapshot.log
StandardError=append:/var/log/mis-portal-equity-snapshot.log
