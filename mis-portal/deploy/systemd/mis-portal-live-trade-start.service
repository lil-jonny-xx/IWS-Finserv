[Unit]
Description=IWS MIS Portal — start Live Trade Daemons for the session
After=network.target

[Service]
Type=oneshot
# Starts one daemon instance per ACTIVE account. All three brokers' order-update WS
# are now verified against a live session (Zerodha end-to-end; Angel + Dhan connect +
# auth, fill mapping unit-tested). Keep this list in sync with the stop-service list.
ExecStart=/usr/bin/systemctl start \
    mis-portal-live-trade@zerodha-dhr.service \
    mis-portal-live-trade@zerodha-hhr.service \
    mis-portal-live-trade@zerodha-sdr.service \
    mis-portal-live-trade@zerodha-rajani.service \
    mis-portal-live-trade@angel-dhr.service \
    mis-portal-live-trade@angel-hhr.service \
    mis-portal-live-trade@dhan-hhr.service \
    mis-portal-live-trade@dhan-rajani.service \
    mis-portal-live-trade@zerodha-hdr.service
