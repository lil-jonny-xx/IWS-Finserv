[Unit]
Description=IWS MIS Portal — stop Live Trade Daemons after the session

[Service]
Type=oneshot
# Stops every possible instance (harmless if one isn't running). Keep this list a
# superset of the start list so nothing is left holding a stale-token socket overnight.
# Every line except the last MUST end in a backslash: systemd silently drops the
# remainder after an unescaped newline, and a never-stopped daemon keeps reporting
# active(running) while its token quietly expires.
ExecStart=/usr/bin/systemctl stop \
    mis-portal-live-trade@zerodha-dhr.service \
    mis-portal-live-trade@zerodha-hhr.service \
    mis-portal-live-trade@zerodha-sdr.service \
    mis-portal-live-trade@zerodha-rajani.service \
    mis-portal-live-trade@angel-dhr.service \
    mis-portal-live-trade@angel-hhr.service \
    mis-portal-live-trade@dhan-hhr.service \
    mis-portal-live-trade@dhan-rajani.service \
    mis-portal-live-trade@zerodha-hdr.service
