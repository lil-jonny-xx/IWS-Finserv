[Unit]
Description=IWS MIS Portal — Live Trade Daemon (%i)
After=network.target postgresql.service redis-server.service
# %i is the account slug (e.g. zerodha-dhr); the daemon maps it to broker+entity.
# Cap restart storms: if a daemon exits >20 times in 5 min (e.g. a dead token), back
# off instead of tight-looping. Well clear of normal reconnects.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=SAdmin
WorkingDirectory=/var/www/mis-portal
Environment=HOME=/home/SAdmin
# Long-running: holds the broker's order-update WebSocket and, on every fill, writes
# it to stock_transaction (real price+time) and PUBLISHes to Redis 'live_trades' for
# the /api/v1/live/trades SSE stream. The start/stop timers bound it to market hours
# (so the daily token, refreshed 06:30 IST, is always fresh at start).
ExecStart=/var/www/.venv/bin/python -m workers.live_trade_daemon --account %i
# Restart=always, NOT on-failure: Angel and Dhan exit cleanly (code 0) when their
# socket closes (KiteTicker self-reconnects, but the Angel/Dhan libs just return), so
# on-failure would NOT restart them — silently ending capture for the rest of the day.
# 'always' makes systemd the reconnect for every broker. An explicit `systemctl stop`
# (the stop timer) is not a restart trigger, so market-hours bounding still holds.
Restart=always
# 15s, not 5s: the daemon now exits 75 on an auth-class WS failure (see _exit_if_auth_fatal)
# so a rotated token is picked up by a fresh process. At 5s the StartLimitBurst=20/300s
# budget was spent in 100 seconds, which is too little for a transient broker-side blip to
# clear. At 15s the retries span the full 5-minute window; if the token is genuinely dead
# the unit then STOPS rather than looping all session, and staleness_monitor's
# check_live_capture reports "socket never opened" that evening.
RestartSec=15
StandardOutput=append:/var/log/mis-portal-live-trade.log
StandardError=append:/var/log/mis-portal-live-trade.log

# No [Install] on purpose: instances are not enabled at boot (the daily token would be
# stale overnight). The start/stop timers manage their lifecycle instead.
